generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// One document (id "app"): what GET app/config hands the Flutter app (17-api-server.md, section 9).
model AppConfig {
  id                 String   @id @map("_id")
  minVersionIos      String   @default("1.0.0")
  minVersionAndroid  String   @default("1.0.0")
  flags              Json     @default("{}")
  maintenanceMessage String?
  updatedAt          DateTime @updatedAt
}

// ── Auth ──

// A Studio account (admin realm). Roles are MOU 3C's: src/utils/permissions.mjs.
model Staff {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  email           String    @unique
  passwordHash    String
  role            String
  // active | suspended | invited. A suspended account can't sign in, and its open sessions stop at the
  // next request. An invited one has no password until its set-password link is used.
  status          String    @default("active")
  lastSignInAt    DateTime?
  // The emails they chose (services/studio/notifications.mjs); until notifySet, their role's usual ones.
  notify          String[]  @default([])
  notifySet       Boolean   @default(false)
  // A set-password link from Studio › Settings › Team: single use, 7 days. Only its hash is kept.
  inviteTokenHash String?
  inviteExpiresAt DateTime?
  invitedBy       String?   @db.ObjectId
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// One signed-in device, for either realm. The refresh token rotates on every use; only hashes are kept.
// Presenting the previous token after its 30-second grace means it was stolen, so the session is revoked.
model Session {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  // member | admin | organizer; subjectId is the Member's, Staff's or Organizer's id
  realm         String
  subjectId     String    @db.ObjectId
  tokenHash     String
  previousHash  String?
  rotatedAt     DateTime?
  // web | mobile
  client        String    @default("web")
  userAgent     String?
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  // Slides forward on each refresh, never past maxExpiresAt.
  expiresAt     DateTime
  maxExpiresAt  DateTime
  revokedAt     DateTime?
  // signed_out | reuse | signed_out_everywhere | password_changed | suspended
  revokedReason String?

  @@index([realm, subjectId])
}

// A member (member realm): a voter now, a stream-site and app viewer later. No password yet;
// they sign in with Google or Apple (MemberIdentity). Email is indexed, not unique: Apple can hide it,
// and on MongoDB a unique index counts every missing value as a duplicate null.
model Member {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  name           String    @default("")
  email          String?
  emailVerified  Boolean   @default(false)
  avatar         String    @default("")
  // active | suspended
  status         String    @default("active")
  // google | apple: shown as "Voting as … with Google"
  lastSignInWith String?
  lastSignInAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([email])
}

// One way a member signs in: the provider's own id for them (the ID token's `sub`), which never changes.
model MemberIdentity {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  memberId  String   @db.ObjectId
  // google | apple
  provider  String
  subject   String
  email     String?
  createdAt DateTime @default(now())

  @@unique([provider, subject])
  @@index([memberId])
}

// ── Voting ── (client/docs/10-voting.md)

type TakenDown {
  at     DateTime
  reason String
}

// A voting campaign. Status (upcoming, ongoing, finished), totals and the winner are worked out from
// these fields and the contestants (services/voting/campaigns.mjs), never stored.
model Campaign {
  id                 String     @id @default(auto()) @map("_id") @db.ObjectId
  title              String
  description        String     @default("")
  // YYYY-MM-DD, Kampala time: voting runs from startDate (at startTime, else 00:00) to endDate (at endTime, else 23:59:59). Empty on a draft still waiting for dates.
  startDate          String     @default("")
  endDate            String     @default("")
  // Optional 24-hour times, Kampala ("18:30"). Without them voting opens at 00:00 and closes at 23:59:59.
  startTime          String?
  endTime            String?
  image              String     @default("")
  category           String     @default("")
  organizer          String     @default("The Artistry360")
  // official | verified
  organizerBadge     String     @default("official")
  // draft | published. Drafts never leave the Studio.
  publishStatus      String     @default("draft")
  featured           Boolean    @default(false)
  // Locked once voting opens.
  votePriceUGX       Int
  vipPriceUGX        Int
  vipDailyVotes      Int
  vipTicketPerk      String     @default("")
  // Set by hand only when the result was decided elsewhere.
  winner             String?
  // Totals from before per-vote tracking.
  importedVotes      Int        @default(0)
  importedRevenueUGX Int        @default(0)
  requestId          String?    @db.ObjectId
  closedAt           DateTime?
  organizerId        String?    @db.ObjectId
  logo               String     @default("")
  prize              String     @default("")
  rules              String     @default("")
  takenDown          TakenDown?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([publishStatus])
}

model Contestant {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  campaignId    String   @db.ObjectId
  fullName      String
  number        Int
  photo         String   @default("")
  bio           String   @default("")
  // Votes carried over from before per-vote tracking.
  importedVotes Int      @default(0)
  // Votes cast on the platform: only the vote services increment it.
  platformVotes Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([campaignId, number])
}

// When a voter last used their free vote in a campaign: one row per voter per campaign, so claiming
// the next one is a single guarded update and two taps at once can't both count.
model FreeVoteSlot {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  campaignId String   @db.ObjectId
  memberId   String   @db.ObjectId
  lastVoteAt DateTime

  @@unique([campaignId, memberId])
}

// Every free vote counted, with the hashed IP and device it came from (decision 4), for the
// device and network checks and for any later review. Never the raw IP or device id.
model FreeVote {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  campaignId    String   @db.ObjectId
  participantId String   @db.ObjectId
  memberId      String   @db.ObjectId
  votes         Int
  // Cast with a VIP pass (votes is then the pass's daily votes).
  vip           Boolean  @default(false)
  ipHash        String
  deviceHash    String
  createdAt     DateTime @default(now())

  @@index([campaignId, deviceHash, createdAt])
  @@index([campaignId, ipHash, createdAt])
  @@index([memberId])
}

// A voter's VIP pass for one campaign, made when its PesaPal order completes: each free vote then
// counts dailyVotes, and the ticket code is their free event ticket. A reversed payment revokes it.
model VipPass {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  campaignId String   @db.ObjectId
  memberId   String   @db.ObjectId
  // The order that last paid for it.
  orderId    String   @db.ObjectId
  dailyVotes Int
  ticketCode String   @unique
  // active | revoked
  status     String   @default("active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([campaignId, memberId])
  @@index([orderId])
}

// The public "Run a campaign" form, reviewed in Studio › Voting › Requests.
model OrganiserRequest {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  orgName      String
  contactName  String
  email        String
  phone        String
  campaignType String
  campaignName String   @default("")
  contestants  String
  start        String
  description  String   @default("")
  // pending | approved | declined
  status       String   @default("pending")
  campaignId   String?  @db.ObjectId
  submittedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
}

// ── Organisers ── A partner who runs their own campaigns from /organizer (organizer realm).
// Accounts are made by a Super Admin from an approved request; the invite link sets the password.
model Organizer {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  orgName         String
  contactName     String
  email           String    @unique
  phone           String    @default("")
  // None until the invite is accepted.
  passwordHash    String?
  // invited | active | disabled
  status          String    @default("invited")
  // Their share of their campaigns' platform revenue, set by a Super Admin.
  sharePercent    Int       @default(70)
  logo            String    @default("")
  // The current invite: only its hash is kept; the link itself is shown once, to the Studio.
  // Indexed, not unique: on MongoDB a unique index counts every missing value as a duplicate null.
  inviteTokenHash String?
  inviteExpiresAt DateTime?
  inviteUsedAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([inviteTokenHash])
}

// An organiser asking to be paid their share of an ended campaign; the Studio pays and marks it paid.
model PayoutRequest {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  organizerId   String    @db.ObjectId
  campaignId    String    @db.ObjectId
  amountUGX     Int
  // MTN MoMo | Airtel Money | Bank transfer
  method        String
  accountName   String
  accountNumber String
  // requested | paid
  status        String    @default("requested")
  requestedAt   DateTime  @default(now())
  paidAt        DateTime?
  // The mobile money or bank reference, entered when marked paid.
  reference     String?
  paidBy        String?   @db.ObjectId

  @@index([organizerId])
  @@index([campaignId])
}

// ── Payments ── One order per checkout: bought votes now, VIP and streaming later.
// Only PesaPal's word (the IPN, or our own status check when the payer comes back) moves it on from pending.
model PaymentOrder {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  // Our merchant reference, quoted to PesaPal and to the payer.
  reference          String    @unique
  // voting | streaming
  module             String
  // votes | vip (voting); subscription | renewal | ppv (streaming)
  kind               String
  campaignId         String?   @db.ObjectId
  participantId      String?   @db.ObjectId
  // The signed-in voter: always for a VIP pass; for bought votes only if they happened to be signed in.
  memberId           String?   @db.ObjectId
  votes              Int       @default(0)
  // Streaming: the plan (and the days it adds) or the title rented, and what the receipt calls it.
  planId             String?
  periodDays         Int?
  titleId            String?
  // ppv: the price stage the order was priced at (early | premiere | standard), for revenue by stage.
  ppvStage           String?
  // Tickets (module tickets, kind ticket): the event, what was bought at what price
  // ([{ typeId, name, qty, priceUGX }], fixed when the order is made), the buyer and their answers.
  // No phone and no payment details are kept.
  ticketEventId      String?
  ticketItems        Json?
  buyerName          String?
  buyerEmail         String?
  ticketAnswers      Json?
  // The seats this order holds while PesaPal is open: true until they're sold (paid) or let go
  // (failed, reversed, or holdExpiresAt passed).
  seatsHeld          Boolean?
  holdExpiresAt      DateTime?
  itemName           String?
  // The price: what the votes, pass, plan or title cost. The client's money; revenue and organiser
  // shares count this.
  amountUGX          Int
  // Charges added on top (services/payments/charges.mjs), fixed when the order is made: system
  // maintenance, PesaPal's fee, and what PesaPal is asked to collect. Missing on orders from before.
  maintenanceUGX     Int?
  pesapalFeeUGX      Int?
  totalUGX           Int?
  // The rates they were worked out at, so a later change never rewrites an old payment.
  maintenancePercent Float?
  pesapalPercent     Float?
  currency           String    @default("UGX")
  // pending | completed | failed | reversed
  status             String    @default("pending")
  // As PesaPal reports it: MTN MoMo, Airtel Money, Visa…
  method             String    @default("")
  provider           String    @default("pesapal")
  trackingId         String?
  confirmationCode   String?
  // Why it failed, when we decided (amount_mismatch, expired, provider_unreachable)
  statusNote         String?
  createdAt          DateTime  @default(now())
  completedAt        DateTime?
  lastCheckedAt      DateTime?
  updatedAt          DateTime  @updatedAt

  @@index([module, status])
  @@index([memberId, module])
  @@index([campaignId])
  @@index([trackingId])
  @@index([ticketEventId])
}

// A payout of the system maintenance balance to the developers, sent by hand (MoMo or bank) and
// recorded here by Finance or a Super Admin. Only the method and its reference: no account numbers.
model MaintenancePayout {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  amountUGX      Int
  // [{ name, amountUGX }]: each developer's part of it.
  shares         Json
  // MTN MoMo | Airtel Money | Bank transfer
  method         String
  reference      String
  note           String   @default("")
  paidAt         DateTime
  recordedBy     String   @db.ObjectId
  recordedByName String
  createdAt      DateTime @default(now())

  @@index([paidAt])
}

// ── Website (Studio › Website and the public pages it feeds) ──

// A message from the public contact form, read in Studio › Overview. Only what the form asks for.
model Enquiry {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  subject   String   @default("General enquiry")
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read])
  @@index([createdAt])
}

// The editable lists behind Studio dropdowns ("+ Add" saves here). One document, id "lists".
model OptionLists {
  id                String   @id @map("_id")
  languages         String[]
  bases             String[]
  // [{ label, roles[] }]; added disciplines join the "Other" group
  disciplineGroups  Json
  newsCategories    String[]
  galleryCategories String[]
  votingCategories  String[]
  updatedAt         DateTime @updatedAt
}

// A running number that is never reused: talent references (T-NNN), booking references (BK-NNNN).
model Counter {
  id    String @id @map("_id")
  value Int
}

// A news story or event. Published ones show on the home page's News & Events strip and /events/:id.
model Article {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  excerpt   String   @default("")
  content   String   @default("")
  location  String   @default("")
  category  String   @default("")
  // YYYY-MM-DD: an event's first day; endDate its last, for a multi-day event
  date      String
  endDate   String   @default("")
  image     String   @default("")
  // Published | Draft
  status    String   @default("Draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, date])
}

// A /gallery photo. "Alumni" ones fill the alumni slider, the rest the grid.
model GalleryPhoto {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String   @default("")
  category  String
  image     String
  // Visible | Hidden
  status    String   @default("Visible")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// One photo per class (Studio › Website › Class Photos); the Classes page shows the Visible ones.
model ClassYear {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  // "2025"
  year      String   @unique
  linkText  String   @default("")
  image     String
  // Visible | Hidden
  status    String   @default("Visible")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One talent: the Studio sees every field, the public roster only an allowlist (never lastName, phone or email).
model Talent {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  // The URL (/profile/t-001) and the public reference (T-001); neither changes nor is reused.
  slug         String   @unique
  talentId     String   @unique
  firstName    String
  lastName     String   @default("")
  primaryRole  String
  otherRoles   String[]
  skills       String[]
  experience   String   @default("")
  base         String   @default("")
  languages    String[]
  // available | on-project | unavailable
  availability String   @default("available")
  published    Boolean  @default(false)
  phone        String   @default("")
  email        String   @default("")
  shortBio     String   @default("")
  profileImg   String   @default("")
  headerImage  String   @default("")
  // [{ id, title, description, image }]
  projects     Json     @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([published])
}

// A talent's showcase clip: a YouTube link, or an upload's https playback URL.
model Monologue {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  // The public reference, T-001
  talentId  String
  title     String
  // youtube | upload
  source    String
  url       String
  duration  Int?
  createdAt DateTime @default(now())

  @@index([talentId])
}

// A guest's request to book one or more talents (the public shortlist form).
model Booking {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  // What the guest is told and quotes back: BK-1042
  reference      String   @unique
  // Public talent references (T-001)
  talentIds      String[]
  name           String
  email          String   @default("")
  phone          String   @default("")
  organisation   String   @default("")
  projectType    String   @default("")
  dates          String   @default("")
  message        String   @default("")
  // new | contacted | confirmed | declined
  status         String   @default("new")
  // { "T-001": "pending" | "confirmed" | "unavailable" | "declined" }
  talentOutcomes Json     @default("{}")
  // [{ at, kind: received | status | reply | note | talent, text, by? }], written by the server only
  activity       Json     @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, createdAt])
}

// A scheduled live class (MOU 3D). The stream itself comes from the video provider, once chosen.
model LiveClass {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  title            String
  instructor       String    @default("")
  startsAt         DateTime
  durationMinutes  Int
  // free | subscription | ppv
  tier             String    @default("subscription")
  priceUGX         Int       @default(0)
  description      String    @default("")
  // scheduled | live | ended | cancelled
  status           String    @default("scheduled")
  recordReplay     Boolean   @default(true)
  // Its stream at the video provider (services/video), made the first time the Studio opens Streaming Setup.
  // The stream key is never stored: it's fetched from the provider each time.
  videoProvider    String?
  liveStreamId     String?
  playbackId       String?
  // Playback links that expire (members-only and pay-per-view, when a signing key is set)
  signedPlayback   Boolean   @default(false)
  // The recording, once the provider has it
  replayPlaybackId String?
  wentLiveAt       DateTime?
  endedAt          DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([startsAt])
  @@index([liveStreamId])
}

// ── Streaming (stream.theartistry360.com and the app; Studio › Streaming) ──

// Video types, categories and content warnings. `key` is what every client calls its id
// (titles store type and category keys, and warning names); it stays when the name changes.
model StreamTerm {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  // type | category | advisory
  kind      String
  key       String
  name      String
  // The name in lower case: one spelling per list.
  nameKey   String
  slug      String
  createdAt DateTime @default(now())

  @@unique([kind, key])
  @@unique([kind, nameKey])
}

// A film or a series. The id (ttl_001) is in every stream site and app link, so it never changes or comes back.
// One uploaded video in Spaces: a film's, an episode's or a title's trailer. The title holds a copy of
// what the Studio shows (status, size, length); this holds the upload, the encode and the key.
model VideoAsset {
  id          String   @id @map("_id")
  titleId     String
  // Set for an episode's video.
  episodeId   String?
  // video | trailer
  kind        String   @default("video")
  // uploading | processing | ready | failed | cancelled
  status      String   @default("uploading")
  fileName    String
  size        Float
  contentType String   @default("video/mp4")
  // originals/<id>/<file> in the bucket, and the multipart upload sending it.
  originalKey String
  uploadId    String?
  partSize    Int
  // Encode results: seconds, the source's size, [{ name, height, bitrate }].
  duration    Float    @default(0)
  width       Int      @default(0)
  height      Int      @default(0)
  renditions  Json     @default("[]")
  // The AES-128 key the pieces are locked with (hex). None for a trailer, which anyone may watch.
  keyHex      String?
  progress    Int      @default(0)
  error       String?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([titleId])
  @@index([status, updatedAt])
}

model StreamTitle {
  id            String    @id @map("_id")
  title         String
  // A StreamTerm type key.
  type          String
  // film | series
  format        String    @default("film")
  synopsis      String    @default("")
  description   String    @default("")
  // StreamTerm category keys.
  categoryIds   String[]
  language      String    @default("English")
  ageRating     String    @default("PG")
  // Content warning names.
  advisories    String[]
  releaseYear   Int
  // [{ name, role }]
  cast          Json      @default("[]")
  crew          Json      @default("[]")
  poster        String    @default("")
  backdrop      String    @default("")
  // The film's upload: { status: none|uploading|processing|ready|failed, assetId?, duration?, … }. Set by uploads and the provider, never by a form.
  video         Json      @default("{\"status\":\"none\"}")
  // The same for the trailer, plus playbackUrl and autoplay.
  trailer       Json?
  // [{ lang, label, src }]
  captions      Json      @default("[]")
  // A series' [{ number, title, episodes[{ id, number, title, synopsis, still, video, intro?, releaseAt? }] }].
  seasons       Json?
  // free | subscription | ppv (only ppv has a price)
  accessTier    String    @default("subscription")
  // ppv: the flat price, or with a schedule its standard price.
  priceUGX      Int       @default(0)
  // ppv premiere pricing: { premiereAt (ISO), earlyUGX, premiereUGX, standardUGX, premiereDays } (services/streaming/pricing.mjs).
  ppv           Json?
  // draft | scheduled | published | unpublished
  publishStatus String    @default("draft")
  releaseAt     DateTime?
  featured      Boolean   @default(false)
  views         Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([publishStatus])
}

// A subscription plan sold on the stream site. The id (plan_monthly) is what the app's store products point at.
model StreamPlan {
  id        String   @id @map("_id")
  name      String
  priceUGX  Int
  // A StreamBillingPeriod id: week, month, quarter, year, or one the Studio added.
  interval  String
  benefits  String[]
  active    Boolean  @default(true)
  highlight Boolean  @default(false)
  // The order the stream site lists them in.
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// How often a plan renews (Studio › Streaming › Subscriptions). The id is what plans store in interval.
model StreamBillingPeriod {
  id        String   @id @map("_id")
  name      String
  // The name lowercased, so two can't differ only in case.
  nameKey   String   @unique
  days      Int
  active    Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A settings document the Studio edits as a whole: "stream-site" (the stream site's home page) and "stream-ads".
model SettingsDoc {
  id        String   @id @map("_id")
  data      Json
  updatedAt DateTime @updatedAt
}

// ── Streaming: who may watch, and what members keep ──

// A member's plan. Paid a period at a time through PesaPal: each payment adds the plan's days to
// currentPeriodEnd, so it's active while that's ahead. Cancelling only stops the reminders to renew.
model StreamSubscription {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  memberId          String    @unique @db.ObjectId
  planId            String
  startedAt         DateTime
  currentPeriodEnd  DateTime
  cancelAtPeriodEnd Boolean   @default(false)
  // The period end each reminder email went out for, so each goes once per period.
  reminderSentFor   DateTime?
  endedNoticeFor    DateTime?
  // As PesaPal reported the last payment: MTN MoMo, Airtel Money, Visa…
  method            String    @default("")
  lastOrderId       String?   @db.ObjectId
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([currentPeriodEnd])
}

// A pay-per-view title a member bought: watchable until expiresAt, 24 hours from payment.
// firstPlayedAt is only on rentals from before, when the 24 hours started on the first play.
model StreamRental {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  memberId      String    @db.ObjectId
  titleId       String
  orderId       String    @unique @db.ObjectId
  firstPlayedAt DateTime?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())

  @@index([memberId, titleId])
}

// My List.
model WatchlistItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  memberId  String   @db.ObjectId
  titleId   String
  createdAt DateTime @default(now())

  @@unique([memberId, titleId])
  @@index([titleId])
}

// A member's rating of a title: meh | like | love. Public titles show the counts.
model TitleRating {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  memberId  String   @db.ObjectId
  titleId   String
  rating    String
  updatedAt DateTime @updatedAt

  @@unique([memberId, titleId])
  @@index([titleId])
}

// Where a member stopped a title (Continue watching): the latest episode for a series. Gone once finished.
model WatchProgress {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  memberId  String   @db.ObjectId
  titleId   String
  episodeId String?
  seconds   Float
  duration  Float
  updatedAt DateTime @updatedAt

  @@unique([memberId, titleId])
}

// Each episode's own bar in a series' episode list.
model EpisodeProgress {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  memberId  String   @db.ObjectId
  titleId   String
  episodeId String
  seconds   Float
  duration  Float
  done      Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([memberId, episodeId])
  @@index([memberId, titleId])
}

// A member's comment on a title. Plain text; hidden once enough members report it, or by the Studio.
model Comment {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  titleId    String
  memberId   String   @db.ObjectId
  // The name at the time; a renamed member's old comments keep theirs.
  authorName String
  body       String
  spoiler    Boolean  @default(false)
  likes      Int      @default(0)
  reports    Int      @default(0)
  hidden     Boolean  @default(false)
  // reports | studio, when hidden
  hiddenBy   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([titleId, createdAt])
  @@index([memberId, createdAt])
  @@index([reports])
}

model CommentLike {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  commentId String   @db.ObjectId
  memberId  String   @db.ObjectId
  createdAt DateTime @default(now())

  @@unique([commentId, memberId])
  @@index([memberId])
}

model CommentReport {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  commentId String   @db.ObjectId
  memberId  String   @db.ObjectId
  createdAt DateTime @default(now())

  @@unique([commentId, memberId])
}

// Who changed money (services/system/audit.mjs): title prices, plans, billing periods and campaign prices, before and after.
model AuditEntry {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  staffId   String?  @db.ObjectId
  staffName String   @default("")
  // title-price | plan | billing-period | campaign-price
  entity    String
  entityId  String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// The Studio header's bell: one row per staff member per event (services/studio/notifications.mjs).
// Kept 90 days.
model StaffNotification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  staffId   String   @db.ObjectId
  // An EVENTS key: enquiry | booking | organiser-request | payout-request | maintenance-due
  event     String
  title     String
  body      String   @default("")
  // The Studio page it opens, e.g. /studio/bookings.
  path      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([staffId, createdAt])
}

// ── Tickets (Website › Tickets; docs/20-ticketing-backend-handoff.md) ──

// A ticket the Studio posts: what it's for, when and where, and its ticket types.
model TicketEvent {
  id          String    @id @map("_id")
  title       String
  description String    @default("")
  image       String    @default("")
  startsAt    DateTime?
  venue       String    @default("")
  // Draft | On sale | Closed
  status      String    @default("Draft")
  // Empty: The Artistry360.
  organizer   String    @default("")
  category    String    @default("")
  // Most tickets in one order (1 to 20); null: 10.
  maxPerOrder Int?
  terms       String    @default("")
  // Asked once per order: [{ id, label, kind: text | choice, options?, required }]
  questions   Json      @default("[]")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
}

// One kind of ticket for an event (Regular, VIP, Early bird). `taken` counts the seats sold
// (valid or used tickets) and held by open checkouts; it never passes `seats`.
model TicketType {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  eventId     String
  // The id the Studio and the pages use (tt_regular), unique within the event.
  key         String
  name        String
  priceUGX    Int
  seats       Int
  taken       Int       @default(0)
  perk        String    @default("")
  onSaleFrom  DateTime?
  onSaleUntil DateTime?
  position    Int       @default(0)

  @@unique([eventId, key])
  @@index([eventId])
}

// One seat: its code is what the door scans. Made only once PesaPal confirms (or at once for a
// free or complimentary ticket). No phone and no payment details.
model Ticket {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  code      String    @unique
  eventId   String
  typeKey   String
  typeName  String
  buyerName String
  email     String    @default("")
  // What this seat cost (0 for free and complimentary ones).
  amountUGX Int
  orderId   String?   @db.ObjectId
  orderRef  String
  // valid | used | void
  status    String    @default("valid")
  usedAt    DateTime?
  // purchase | complimentary
  source    String    @default("purchase")
  // Complimentary: why, and who issued it (from their session).
  note      String    @default("")
  issuedBy  String    @default("")
  // The order's answers to the event's questions, by question id.
  answers   Json?
  issuedAt  DateTime  @default(now())

  @@index([eventId, status])
  @@index([orderId])
  @@index([email, eventId])
}
