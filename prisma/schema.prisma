generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// One document (id "app"): what GET app/config hands the Flutter app (17-api-server.md, section 9).
model AppConfig {
  id                 String   @id @map("_id")
  minVersionIos      String   @default("1.0.0")
  minVersionAndroid  String   @default("1.0.0")
  flags              Json     @default("{}")
  maintenanceMessage String?
  updatedAt          DateTime @updatedAt
}

// ── Auth ──

// A Studio account (admin realm). Roles are MOU 3C's: src/utils/permissions.mjs.
model Staff {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String    @unique
  passwordHash String
  role         String
  // active | suspended. A suspended account can't sign in, and its open sessions stop at the next request.
  status       String    @default("active")
  lastSignInAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// One signed-in device, for either realm. The refresh token rotates on every use; only hashes are kept.
// Presenting the previous token after its 30-second grace means it was stolen, so the session is revoked.
model Session {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  // member | admin | organizer; subjectId is the Member's, Staff's or Organizer's id
  realm         String
  subjectId     String    @db.ObjectId
  tokenHash     String
  previousHash  String?
  rotatedAt     DateTime?
  // web | mobile
  client        String    @default("web")
  userAgent     String?
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  // Slides forward on each refresh, never past maxExpiresAt.
  expiresAt     DateTime
  maxExpiresAt  DateTime
  revokedAt     DateTime?
  // signed_out | reuse | signed_out_everywhere | password_changed | suspended
  revokedReason String?

  @@index([realm, subjectId])
}

// A member (member realm): a voter now, a stream-site and app viewer later. No password yet;
// they sign in with Google or Apple (MemberIdentity). Email is indexed, not unique: Apple can hide it,
// and on MongoDB a unique index counts every missing value as a duplicate null.
model Member {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  name           String    @default("")
  email          String?
  emailVerified  Boolean   @default(false)
  avatar         String    @default("")
  // active | suspended
  status         String    @default("active")
  // google | apple: shown as "Voting as … with Google"
  lastSignInWith String?
  lastSignInAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([email])
}

// One way a member signs in: the provider's own id for them (the ID token's `sub`), which never changes.
model MemberIdentity {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  memberId  String   @db.ObjectId
  // google | apple
  provider  String
  subject   String
  email     String?
  createdAt DateTime @default(now())

  @@unique([provider, subject])
  @@index([memberId])
}

// ── Voting ── (client/docs/10-voting.md)

type TakenDown {
  at     DateTime
  reason String
}

// A voting campaign. Status (upcoming, ongoing, finished), totals and the winner are worked out from
// these fields and the contestants (services/voting/campaigns.mjs), never stored.
model Campaign {
  id                 String     @id @default(auto()) @map("_id") @db.ObjectId
  title              String
  description        String     @default("")
  // YYYY-MM-DD, Kampala time: voting runs from 00:00 on startDate to 23:59:59 on endDate. Empty on a draft still waiting for dates.
  startDate          String     @default("")
  endDate            String     @default("")
  image              String     @default("")
  category           String     @default("")
  organizer          String     @default("The Artistry360")
  // official | verified
  organizerBadge     String     @default("official")
  // draft | published. Drafts never leave the Studio.
  publishStatus      String     @default("draft")
  featured           Boolean    @default(false)
  // Locked once voting opens.
  votePriceUGX       Int
  vipPriceUGX        Int
  vipDailyVotes      Int
  vipTicketPerk      String     @default("")
  // Set by hand only when the result was decided elsewhere.
  winner             String?
  // Totals from before per-vote tracking.
  importedVotes      Int        @default(0)
  importedRevenueUGX Int        @default(0)
  requestId          String?    @db.ObjectId
  closedAt           DateTime?
  organizerId        String?    @db.ObjectId
  logo               String     @default("")
  prize              String     @default("")
  rules              String     @default("")
  takenDown          TakenDown?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([publishStatus])
}

model Contestant {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  campaignId    String   @db.ObjectId
  fullName      String
  number        Int
  photo         String   @default("")
  bio           String   @default("")
  // Votes carried over from before per-vote tracking.
  importedVotes Int      @default(0)
  // Votes cast on the platform: only the vote services increment it.
  platformVotes Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([campaignId, number])
}

// When a voter last used their free vote in a campaign: one row per voter per campaign, so claiming
// the next one is a single guarded update and two taps at once can't both count.
model FreeVoteSlot {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  campaignId String   @db.ObjectId
  memberId   String   @db.ObjectId
  lastVoteAt DateTime

  @@unique([campaignId, memberId])
}

// Every free vote counted, with the hashed IP and device it came from (decision 4), for the
// device and network checks and for any later review. Never the raw IP or device id.
model FreeVote {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  campaignId    String   @db.ObjectId
  participantId String   @db.ObjectId
  memberId      String   @db.ObjectId
  votes         Int
  // Cast with a VIP pass (votes is then the pass's daily votes).
  vip           Boolean  @default(false)
  ipHash        String
  deviceHash    String
  createdAt     DateTime @default(now())

  @@index([campaignId, deviceHash, createdAt])
  @@index([campaignId, ipHash, createdAt])
  @@index([memberId])
}

// A voter's VIP pass for one campaign, made when its PesaPal order completes: each free vote then
// counts dailyVotes, and the ticket code is their free event ticket. A reversed payment revokes it.
model VipPass {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  campaignId String   @db.ObjectId
  memberId   String   @db.ObjectId
  // The order that last paid for it.
  orderId    String   @db.ObjectId
  dailyVotes Int
  ticketCode String   @unique
  // active | revoked
  status     String   @default("active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([campaignId, memberId])
  @@index([orderId])
}

// The public "Run a campaign" form, reviewed in Studio › Voting › Requests.
model OrganiserRequest {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  orgName      String
  contactName  String
  email        String
  phone        String
  campaignType String
  campaignName String   @default("")
  contestants  String
  start        String
  description  String   @default("")
  // pending | approved | declined
  status       String   @default("pending")
  campaignId   String?  @db.ObjectId
  submittedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
}

// ── Organisers ── A partner who runs their own campaigns from /organizer (organizer realm).
// Accounts are made by a Super Admin from an approved request; the invite link sets the password.
model Organizer {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  orgName         String
  contactName     String
  email           String    @unique
  phone           String    @default("")
  // None until the invite is accepted.
  passwordHash    String?
  // invited | active | disabled
  status          String    @default("invited")
  // Their share of their campaigns' platform revenue, set by a Super Admin.
  sharePercent    Int       @default(70)
  logo            String    @default("")
  // The current invite: only its hash is kept; the link itself is shown once, to the Studio.
  // Indexed, not unique: on MongoDB a unique index counts every missing value as a duplicate null.
  inviteTokenHash String?
  inviteExpiresAt DateTime?
  inviteUsedAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([inviteTokenHash])
}

// An organiser asking to be paid their share of an ended campaign; the Studio pays and marks it paid.
model PayoutRequest {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  organizerId   String    @db.ObjectId
  campaignId    String    @db.ObjectId
  amountUGX     Int
  // MTN MoMo | Airtel Money | Bank transfer
  method        String
  accountName   String
  accountNumber String
  // requested | paid
  status        String    @default("requested")
  requestedAt   DateTime  @default(now())
  paidAt        DateTime?
  // The mobile money or bank reference, entered when marked paid.
  reference     String?
  paidBy        String?   @db.ObjectId

  @@index([organizerId])
  @@index([campaignId])
}

// ── Payments ── One order per checkout: bought votes now, VIP and streaming later.
// Only PesaPal's word (the IPN, or our own status check when the payer comes back) moves it on from pending.
model PaymentOrder {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  // Our merchant reference, quoted to PesaPal and to the payer.
  reference        String    @unique
  // voting (later: streaming)
  module           String
  // votes | vip
  kind             String
  campaignId       String?   @db.ObjectId
  participantId    String?   @db.ObjectId
  // The signed-in voter: always for a VIP pass; for bought votes only if they happened to be signed in.
  memberId         String?   @db.ObjectId
  votes            Int       @default(0)
  amountUGX        Int
  currency         String    @default("UGX")
  // pending | completed | failed | reversed
  status           String    @default("pending")
  // As PesaPal reports it: MTN MoMo, Airtel Money, Visa…
  method           String    @default("")
  provider         String    @default("pesapal")
  trackingId       String?
  confirmationCode String?
  // Why it failed, when we decided (amount_mismatch, expired, provider_unreachable)
  statusNote       String?
  createdAt        DateTime  @default(now())
  completedAt      DateTime?
  lastCheckedAt    DateTime?
  updatedAt        DateTime  @updatedAt

  @@index([module, status])
  @@index([campaignId])
  @@index([trackingId])
}
