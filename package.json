{
  "name": "artistry360-server",
  "version": "1.0.0",
  "description": "The one API for theartistry360.com, the Studio, the stream site and the app",
  "main": "src/index.mjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"node esbuild.config.mjs --watch\" \"nodemon dist/index.cjs\"",
    "start": "node dist/index.cjs",
    "build": "rimraf dist && NODE_ENV='production' node esbuild.config.mjs",
    "postinstall": "prisma generate",
    "postbuild": "prisma generate",
    "db:push": "prisma db push",
    "staff:create": "node scripts/create-staff.mjs"
  },
  "author": "Joshua Kimbareeba",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "nodemon": "^3.1.14",
    "prisma": "6.5.0",
    "rimraf": "6.0.1"
  },
  "dependencies": {
    "@prisma/client": "6.5.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.34.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^6.9.16",
    "rate-limit-redis": "^4.2.0",
    "redis": "^4.7.0",
    "socket.io": "^4.8.4",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0",
    "zod": "^4.6.7"
  }
}
