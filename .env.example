# Copy to .env and fill in. The server checks these at start-up (src/env.mjs).
NODE_ENV="development"
PORT=5000

# Prisma needs MongoDB running as a replica set (Atlas and DigitalOcean Managed MongoDB already are).
# Local: docker run -d --name artistry360-mongo --restart unless-stopped -p 27019:27019 -v artistry360-mongo:/data/db mongo:7 --replSet rs0 --port 27019 --bind_ip_all
#   then once: docker exec artistry360-mongo mongosh --port 27019 --eval 'rs.initiate({_id:"rs0",members:[{_id:0,host:"localhost:27019"}]})'
DATABASE_URL="mongodb://localhost:27019/artistry360?replicaSet=rs0&directConnection=true"

# One signing secret per realm (Studio, member, organiser), so no realm's token can pass as another's.
# At least 32 characters each, and different. Generate with: openssl rand -hex 32
ADMIN_TOKEN_SECRET=""
MEMBER_TOKEN_SECRET=""
ORGANIZER_TOKEN_SECRET=""

# Local: the Homebrew Redis on 6379.
REDIS_URL="redis://localhost:6379"

# Where theartistry360.com runs; links in emails, and PesaPal's return to the site, point here.
APP_URL="http://localhost:5173"
# Where this API is reached from the internet; PesaPal's IPN calls API_URL/api/v1/payments/pesapal/ipn.
API_URL="http://localhost:5000"

# PesaPal API 3.0. sandbox (cybqa.pesapal.com) or live (pay.pesapal.com); keys from the PesaPal dashboard.
PESAPAL_ENV="sandbox"
PESAPAL_CONSUMER_KEY=""
PESAPAL_CONSUMER_SECRET=""
# Optional: the IPN address, when it isn't API_URL/api/v1/payments/pesapal/ipn.
PESAPAL_IPN_URL=""

# Google sign-in: console.cloud.google.com, Google Auth Platform, Clients. Each ends in .apps.googleusercontent.com.
# The web client is used by theartistry360.com and the stream site; Android and iOS only once the app is built.
GOOGLE_WEB_CLIENT_ID=""
GOOGLE_ANDROID_CLIENT_ID=""
GOOGLE_IOS_CLIENT_ID=""
# The web client's secret, for the stream site's redirect sign-in only.
GOOGLE_CLIENT_SECRET=""

# Sign in with Apple: developer.apple.com, Certificates, Identifiers & Profiles.
# Team ID: top right of the developer page. Services ID: the websites' identifier (e.g. com.theartistry360.web).
# Bundle ID: the app's App ID (e.g. com.theartistry360.app). Key ID and the .p8 file: Keys, Sign in with Apple.
APPLE_TEAM_ID=""
APPLE_SERVICES_ID=""
APPLE_BUNDLE_ID=""
APPLE_KEY_ID=""
# Where the .p8 is saved, relative to server/. Keys under keys/ are never committed.
APPLE_PRIVATE_KEY_PATH="keys/AuthKey_XXXXXXXXXX.p8"

# Email through Zoho Mail. Without a user and password, nothing is sent.
ZOHO_SMTP_HOST="smtppro.zoho.com"
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=""
ZOHO_SMTP_PASSWORD=""
MAIL_FROM="The Artistry360 <hello@theartistry360.com>"
MAIL_REPLY_TO=""

# Video for live classes (MOU 4.3). VIDEO_PROVIDER picks the provider: "mux" or "cloudflare"; only its keys are needed.
# Mux dashboard (dashboard.mux.com), in the environment you're using:
#   Settings > Access Tokens: a token with Mux Video read and write gives the token ID and secret.
#   Settings > Webhooks: point it at https://api.theartistry360.com/api/v1/academy/webhooks/mux and copy its signing secret.
#   Settings > Signing Keys (optional): makes members-only and pay-per-view playback links expire; paste the
#   base64 private key exactly as Mux shows it. Free classes play from public links either way.
VIDEO_PROVIDER="mux"
MUX_TOKEN_ID=""
MUX_TOKEN_SECRET=""
MUX_WEBHOOK_SECRET=""
MUX_SIGNING_KEY_ID=""
MUX_SIGNING_PRIVATE_KEY=""

# Cloudflare Stream (dash.cloudflare.com), with VIDEO_PROVIDER="cloudflare". Needs a Stream subscription.
#   Account ID: on the Stream page's right-hand side.
#   Customer code: the "customer-<code>" in any Stream playback link (Stream > a video > Embed); just the code.
#   API token: My Profile > API Tokens > Create token, with Account > Stream > Edit.
#   Recording-ready webhook: no dashboard page. Run once (it prints a "secret" for CLOUDFLARE_STREAM_WEBHOOK_SECRET):
#     curl -X PUT https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/stream/webhook \
#       -H "Authorization: Bearer <API_TOKEN>" -H "Content-Type: application/json" \
#       -d '{"notificationUrl":"https://api.theartistry360.com/api/v1/academy/webhooks/cloudflare"}'
#   Live / ended webhook: Notifications > Destinations > Webhooks > Create, same URL, with a secret you make up
#     (CLOUDFLARE_NOTIFICATION_SECRET); then Notifications > Add > Stream > "Stream Live Input",
#     events connected and disconnected, delivered to that webhook.
#   Signing key (optional, for members-only and pay-per-view links that expire): run once
#     curl -X POST https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/stream/keys -H "Authorization: Bearer <API_TOKEN>"
#   and paste result.id and result.pem exactly as returned.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_STREAM_API_TOKEN=""
CLOUDFLARE_STREAM_CUSTOMER_CODE=""
CLOUDFLARE_STREAM_WEBHOOK_SECRET=""
CLOUDFLARE_NOTIFICATION_SECRET=""
CLOUDFLARE_STREAM_SIGNING_KEY_ID=""
CLOUDFLARE_STREAM_SIGNING_KEY=""

# Streaming videos: DigitalOcean Spaces (cloud.digitalocean.com > Spaces Object Storage). Without the key and
# secret, the Studio's uploads say they aren't connected yet.
#   1. Create a Spaces bucket: pick the region nearest your viewers (fra1 or ams3 for Uganda), turn the CDN on,
#      and leave file listing restricted. SPACES_REGION is that region, SPACES_BUCKET the bucket's name.
#   2. API > Spaces Keys > Generate New Key, limited to this bucket with read/write/delete: the key and its secret.
#   3. Run `yarn spaces:setup` once. It lets the Studio upload straight to the bucket (CORS) and deletes uploads
#      nobody finished after 2 days.
#   SPACES_CDN_URL only for a custom CDN domain (e.g. https://media.theartistry360.com); otherwise it's worked out.
# Converting uploads needs ffmpeg on the machine that runs the worker (apt install ffmpeg, or brew install ffmpeg).
# The API converts them itself (VIDEO_WORKER="on"); for a busy catalogue run `yarn worker` on its own droplet with
# this same .env, and set VIDEO_WORKER="off" here. A 2-hour film needs about 8 GB free in VIDEO_WORK_DIR (default: /tmp).
SPACES_REGION=""
SPACES_BUCKET=""
SPACES_KEY=""
SPACES_SECRET=""
SPACES_CDN_URL=""
VIDEO_WORKER="on"
VIDEO_ENCODE_CONCURRENCY="1"
VIDEO_ENCODE_PRESET="veryfast"
VIDEO_WORK_DIR=""
